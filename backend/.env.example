# Medicare backend environment template
# Never commit real credentials or private keys.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/medicare

# Firebase Admin verification / messaging / optional private media
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Optional application secret retained only where an approved feature requires it
JWT_SECRET=

ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# Optional future/approved integration variables
GEMINI_API_KEY=
MAX_UPLOAD_SIZE_MB=10
