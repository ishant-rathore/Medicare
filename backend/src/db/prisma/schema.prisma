// =============================================================================
// backend/src/db/prisma/schema.prisma
// PostgreSQL database schema for Medicare backend
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum MedicineType {
  TABLET
  CAPSULE
  SYRUP
  DROPS
  INJECTION
  OINTMENT
  INHALER
}

enum MealTiming {
  BEFORE_FOOD
  AFTER_FOOD
  WITH_FOOD
  AFTER_DINNER
  EMPTY_STOMACH
  BEDTIME
}

enum RecurrenceType {
  ONE_TIME
  DAILY
  WEEKLY
  ALTERNATE_DAYS
  EVERY_8_HOURS
  EVERY_12_HOURS
  AS_NEEDED
}

enum DoseStatus {
  PENDING
  TAKEN
  SNOOZED
  SKIPPED
  MISSED
}

enum CaregiverAccessLevel {
  VIEW_ONLY
  MANAGE
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum MediaType {
  MEDICINE_PHOTO
  PRESCRIPTION
  PROFILE_PHOTO
}

// =============================================================================
// USER
// =============================================================================

model User {
  id                String    @id @default(uuid())
  firebaseUid       String    @unique @map("firebase_uid")
  email             String?   @unique
  name              String
  nickname          String?
  age               Int?
  gender            String?
  bloodGroup        String?   @map("blood_group")
  phone             String?
  address           String?
  preferredLanguage String    @default("en") @map("preferred_language")
  photoUrl          String?   @map("photo_url")
  healthConditions  String[]  @map("health_conditions")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // Relations
  medicines          Medicine[]
  reminders          Reminder[]
  doseEvents         DoseEvent[]
  caregiverRelations CaregiverRelation[] @relation("user_caregivers")
  caregiverOf        CaregiverRelation[] @relation("caregiver_users")
  refillRules        RefillRule[]
  deviceTokens       DeviceToken[]
  mediaAssets        MediaAsset[]

  @@map("users")
}

// =============================================================================
// MEDICINE
// =============================================================================

model Medicine {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  name              String
  genericName       String?      @map("generic_name")
  dosage            String
  type              MedicineType
  color             String?
  shape             String?
  category          String?
  mealTiming        MealTiming   @map("meal_timing")
  instructions      String[]
  stockCount        Int          @default(30) @map("stock_count")
  lowStockThreshold Int          @default(5) @map("low_stock_threshold")
  expiryDate        DateTime?    @map("expiry_date")
  isEssential       Boolean      @default(false) @map("is_essential")
  isActive          Boolean      @default(true) @map("is_active")
  notes             String?
  photoUrl          String?      @map("photo_url")
  prescribedBy      String?      @map("prescribed_by")
  customVoiceScript String?      @map("custom_voice_script")
  startDate         DateTime?    @map("start_date")
  endDate           DateTime?    @map("end_date")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders  Reminder[]
  doseEvents DoseEvent[]
  refillRule RefillRule?

  @@index([userId])
  @@index([userId, isActive])
  @@map("medicines")
}

// =============================================================================
// REMINDER
// =============================================================================

model Reminder {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  medicineId     String         @map("medicine_id")
  scheduledTimes String[]       @map("scheduled_times") // ["08:00", "14:00", "20:00"]
  recurrence     RecurrenceType
  daysOfWeek     Int[]          @map("days_of_week") // [0,1,2,3,4,5,6]
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  isActive       Boolean        @default(true) @map("is_active")
  snoozeMinutes  Int            @default(10) @map("snooze_minutes")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  // Relations
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine  Medicine    @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  doseEvents DoseEvent[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("reminders")
}

// =============================================================================
// DOSE EVENT
// local_event_id MUST be unique to prevent duplicate sync
// =============================================================================

model DoseEvent {
  id             String     @id @default(uuid())
  localEventId   String     @unique @map("local_event_id") // UUID generated on device
  userId         String     @map("user_id")
  medicineId     String     @map("medicine_id")
  reminderId     String?    @map("reminder_id")
  medicineName   String     @map("medicine_name")
  dosage         String
  mealTiming     MealTiming @map("meal_timing")
  scheduledTime  String     @map("scheduled_time") // "08:00"
  scheduledDate  DateTime   @map("scheduled_date")
  status         DoseStatus @default(PENDING)
  actionAt       DateTime?  @map("action_at") // When user took/snoozed/skipped
  snoozeUntil    DateTime?  @map("snooze_until")
  spokenScript   String?    @map("spoken_script")
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine Medicine  @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, scheduledDate])
  @@index([userId, status])
  @@index([localEventId])
  @@map("dose_events")
}

// =============================================================================
// CAREGIVER RELATION
// =============================================================================

model CaregiverRelation {
  id              String               @id @default(uuid())
  userId          String               @map("user_id") // The senior citizen
  caregiverId     String               @map("caregiver_id") // The caregiver's userId
  accessLevel     CaregiverAccessLevel @default(VIEW_ONLY) @map("access_level")
  relationLabel   String?              @map("relation_label") // "Son", "Daughter", etc.
  isActive        Boolean              @default(true) @map("is_active")
  notifyOnMissed  Boolean              @default(true) @map("notify_on_missed")
  notifyOnTaken   Boolean              @default(false) @map("notify_on_taken")
  notifyOnLowStock Boolean             @default(true) @map("notify_on_low_stock")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  // Relations
  user      User @relation("user_caregivers", fields: [userId], references: [id], onDelete: Cascade)
  caregiver User @relation("caregiver_users", fields: [caregiverId], references: [id], onDelete: Cascade)

  @@unique([userId, caregiverId])
  @@index([userId])
  @@index([caregiverId])
  @@map("caregiver_relations")
}

// =============================================================================
// REFILL RULE
// =============================================================================

model RefillRule {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  medicineId         String   @unique @map("medicine_id")
  lowStockThreshold  Int      @default(5) @map("low_stock_threshold")
  refillQuantity     Int      @default(30) @map("refill_quantity")
  autoAlertEnabled   Boolean  @default(true) @map("auto_alert_enabled")
  lastRefillDate     DateTime? @map("last_refill_date")
  nextRefillDate     DateTime? @map("next_refill_date")
  pharmacyName       String?  @map("pharmacy_name")
  pharmacyPhone      String?  @map("pharmacy_phone")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refill_rules")
}

// =============================================================================
// DEVICE TOKEN (FCM)
// =============================================================================

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String   @default("android") // "android" | "ios"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// =============================================================================
// MEDIA ASSET
// =============================================================================

model MediaAsset {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        MediaType
  url         String
  storagePath String    @map("storage_path")
  mimeType    String    @map("mime_type")
  sizeBytes   Int?      @map("size_bytes")
  linkedId    String?   @map("linked_id") // medicineId or null for profile photos
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("media_assets")
}

// =============================================================================
// SYNC LOG
// Tracks sync operations for debugging and audit
// =============================================================================

model SyncLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  operation   String   // "CREATE" | "UPDATE" | "DELETE"
  resource    String   // "medicine" | "reminder" | "dose_event"
  resourceId  String   @map("resource_id")
  status      String   // "success" | "failed" | "duplicate"
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@map("sync_log")
}
