# =============================================================================
# Medicare – Voice Reminders for Senior Citizens
# Environment Variables Example
# Copy this file to .env and fill in real values
# NEVER commit .env with real credentials
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# DATABASE – PostgreSQL (Neon / Supabase / Railway / Self-hosted)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/medicare_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# FIREBASE – Admin SDK (Server Side)
# Get from Firebase Console → Project Settings → Service Accounts
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Firebase Web Config (Public – Client Side, safe to expose in app code)
# Used in Flutter's google-services.json, NOT in .env
# Kept here for documentation reference only
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# JWT (if using as fallback / additional layer)
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-very-long-random-secret-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# GEMINI AI (Google)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# MEDIA / STORAGE
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# -----------------------------------------------------------------------------
# NOTIFICATIONS (Firebase Cloud Messaging)
# -----------------------------------------------------------------------------
FCM_SERVER_KEY=your-fcm-server-key

# -----------------------------------------------------------------------------
# FLUTTER APP (reference only – these go into Flutter env config, not .env)
# -----------------------------------------------------------------------------
# FLUTTER_API_BASE_URL=http://localhost:3000/api/v1
# FLUTTER_FIREBASE_PROJECT=your-firebase-project-id
