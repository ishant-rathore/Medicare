root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart}]
indent_size = 2

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false

[*.{py}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{sql}]
indent_size = 2
